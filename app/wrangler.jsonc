{
  "name": "fireiq",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "fireiq.pandor.cc", "custom_domain": true }
  ]
}
